#
# DO NOT EDIT THIS FILE
#
# Create a new .htaccess file in your htdocs
# directory (or example.com/htdocs/ directory)
# to add your own rules or override these rules.
#
##################################################


DirectoryIndex index.php index.html index.htm index2.html

# Atau jika ingin redirect ke file spesifik dengan parameter error
# ErrorDocument 403 polar.web.id/error_page.html?error=403
# ErrorDocument 404 polar.web.id/error_page.html?error=404
# ErrorDocument 500 polar.web.id/error_page.html?error=500
ErrorDocument 400 /error_page.html
ErrorDocument 404 /error_page.html
ErrorDocument 401 /error_page.html
ErrorDocument 403 /error_page.html
ErrorDocument 500 /error_page.html
ErrorDocument 503 /error_page.html
